{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts/setup-admin.mjs scripts/backup.mjs scripts/verify-http.mjs next.config.ts eslint.config.mjs --max-warnings 0",
    "test": "node --conditions=react-server --import tsx --test tests/commerce.test.mts",
    "test:http": "node scripts/verify-http.mjs",
    "admin:setup": "node scripts/setup-admin.mjs",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "format": "prettier --write src tests scripts/setup-admin.mjs scripts/backup.mjs scripts/verify-http.mjs next.config.ts eslint.config.mjs package.json"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
