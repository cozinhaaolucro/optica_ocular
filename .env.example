# Node 24. Copy configuration into .env.local (ignored by Git).
OCULAR_SITE_URL=http://localhost:3000
OCULAR_ADMIN_PASSWORD=

# Supabase PostgreSQL: transaction pooler recommended for Vercel.
# Use the complete URI from Connect; percent-encode special password characters.
# Never prefix DATABASE_URL or SUPABASE_SECRET_KEY with NEXT_PUBLIC_.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# SQLite fallback for local development without DATABASE_URL.
OCULAR_DB_PATH=data/ocular.sqlite
# Explicit read-only reference catalog. Automatic on Vercel only without DATABASE_URL.
OCULAR_CATALOG_PREVIEW=false

# Enable indexing after approving the real catalog and commercial content.
OCULAR_INDEXING_ENABLED=false
OCULAR_TELEMETRY_ENABLED=false
OCULAR_PICKUP_ENABLED=true
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
OCULAR_TRUST_PROXY=false
