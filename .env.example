# Node 24, one application instance with persistent local storage.
OCULAR_SITE_URL=http://localhost:3000
OCULAR_DB_PATH=data/ocular.sqlite
# Run npm run admin:setup, or set a random secret of at least 24 characters.
OCULAR_ADMIN_PASSWORD=
# Enable only after reviewing catalog, domain and commercial content.
OCULAR_INDEXING_ENABLED=false
# Optional first-party metrics, no customer or cart identifiers.
OCULAR_TELEMETRY_ENABLED=false
# True only behind a trusted proxy which overwrites X-Forwarded-For.
OCULAR_TRUST_PROXY=false
